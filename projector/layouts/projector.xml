<?xml version="1.0" encoding="UTF-8" ?>
<container scrollable="0" size="540,640" color="#888888cc">
    <label pos="235,10" id="title">Projector</label>
    <container color="#00000099" id="settings_1" scrollable="0" size="250,240" pos="10,30">
        <label pos="10,10">Projection size in blocks:</label>
        <textbox id="projection_size_x" pos="10,30" size="110,30" consumer="projection_size_x_consumer" 
				 validator="projection_size_x_validator" supplier="projection_size_x_supplier" placeholder="Size X"></textbox>
        <textbox id="projection_size_y" pos="130,30" size="110,30" consumer="projection_size_y_consumer" 
				 validator="projection_size_y_validator" supplier="projection_size_y_supplier" placeholder="Size Y"></textbox>
        <label pos="10,70">Projection offset in blocks:</label>
        <textbox id="projection_offset_x" pos="10,90" size="70,30" consumer="projection_offset_x_consumer"
				 validator="projection_offset_x_validator" supplier="projection_offset_x_supplier" placeholder="Offset X"></textbox>
        <textbox id="projection_offset_y" pos="90,90" size="70,30" consumer="projection_offset_y_consumer"
				 validator="projection_offset_y_validator" supplier="projection_offset_y_supplier" placeholder="Offset Y" ></textbox>
        <textbox id="projection_offset_z" pos="170,90" size="70,30" consumer="projection_offset_z_consumer"
				 validator="projection_offset_z_validator" supplier="projection_offset_z_supplier" placeholder="Offset Z" ></textbox>
        <label pos="10,130">Capture size in pixels:</label>
		<checkbox size="250,30" pos="10,150" consumer="same_size_consumer" id="same_size" checked="true">Same as projection size</checkbox>
        <textbox id="capture_size_x" pos="10,190" size="110,30" consumer="capture_size_x_consumer" 
				 validator="capture_size_x_validator" supplier="capture_size_x_supplier" placeholder="Size X"></textbox>
        <textbox id="capture_size_y" pos="130,190" size="110,30" consumer="capture_size_y_consumer"
				 validator="capture_size_y_validator" supplier="capture_size_y_supplier" placeholder="Size Y"></textbox>
    </container>
    <container color="#00000099" id="settings_2" scrollable="0" size="250,240" pos="280,30">
        <label id="refresh_rate_label" pos="10,10">Projection refresh rate: 30</label>
        <trackbar id="refresh_rate" min="1" pos="10,30" consumer="fps_consumer" max="60" value="30" size="230,30"/>
        <checkbox size="200,30" pos="10,70" id="clear_on_stop" checked="true">Clear on stop</checkbox>
        <button onclick="toggle_axis()" id="axis" size="230,30" pos="10,150">Axis: X</button>
        <button onclick="toggle_orientation()" id="orientation" size="230,30" pos="10,110">Orientation: Vertical</button>
		<checkbox size="250,30" pos="10,190" id="rgb_mode" checked="false">Use RGB mode</checkbox>
	</container>
    <panel pos="10,440" max-length="190" id="logs" size="520,190"/>
    <button id="main_button" onclick="main_button_func()" pos="10,340" size="520,30">Start</button>
    <label pos="10,420">Logs:</label>
    <label id="status" pos="10,280">Status:</label>
    <button onclick="synchronize()" id="sync" size="520,30" pos="10,300">Synchronize</button>
    <button id="clear" onclick="clear_display()" size="520,30" pos="10,380">Clear area</button>
</container>